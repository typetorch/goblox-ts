{
	"name": "game",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": { "$path": "node_modules/@rbxts" }
				}
			},
			"TS": { "$path": "out/shared" },
			"Lib": { "$path": "lib.lua" },
			"Nested": { "$path": "nested" },
			"Other": { "$path": "other.project.json" },
			"Optional": { "$path": { "optional": "missing" } },
			"zeta": { "$path": "num" },
			"12": { "$className": "Folder", "3": { "$className": "Folder" } }
		},
		"ServerScriptService": { "$className": "ServerScriptService", "TS": { "$path": "out/server" } },
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": { "$className": "StarterPlayerScripts", "TS": { "$path": "out/client" } }
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": { "FilteringEnabled": true },
			"Thing": { "$path": "assets/thing.model.json" }
		}
	}
}
