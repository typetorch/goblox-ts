{
	"name": "goblox-smoke",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": { "$path": "node_modules/@rbxts" }
				}
			},
			"shared": { "$path": "out/shared" }
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"server": { "$path": "out/server" }
		}
	}
}
